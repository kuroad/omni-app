generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Path {
  id         String      @id
  name       String      @unique
  characters Character[]
  lightCones LightCone[]
}

model Element {
  id         String      @id
  name       String      @unique
  characters Character[]
}

model Character {
  id        String   @id
  name      String
  rarity    Int      // 4 or 5
  pathId    String
  elementId String
  path      Path     @relation(fields: [pathId], references: [id])
  element   Element  @relation(fields: [elementId], references: [id])
  
  // Relations
  traces    CharacterTrace[]
}

model CharacterTrace {
  id          String    @id @default(uuid())
  characterId String
  name        String
  description String
  type        String    // e.g. Basic ATK, Skill, Ultimate, Talent
  character   Character @relation(fields: [characterId], references: [id])
}

model RelicSet {
  id         String  @id
  name       String
  desc       String? // JSON stringified array or concatenated
  icon       String?
  relics     Relic[]
}

model Relic {
  id         String   @id
  name       String
  setId      String
  icon       String?
  relicSet   RelicSet @relation(fields: [setId], references: [id])
}

model LightCone {
  id        String  @id
  name      String
  rarity    Int
  pathId    String
  desc      String?
  icon      String?
  path      Path    @relation(fields: [pathId], references: [id])
}

model Item {
  id        String  @id
  name      String
  type      String
  subType   String?
  rarity    Int
  icon      String?
}

model Achievement {
  id        String   @id
  seriesId  String
  title     String
  desc      String
  hide      Boolean  @default(false)
}

model SimulatedBlessing {
  id           String   @id
  name         String
  desc         String
  enhancedDesc String?
}

model SimulatedCurio {
  id        String   @id
  name      String
  desc      String
  bgDesc    String?
  icon      String?
}
