generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Character {
  id        String   @id
  name      String
  rarity    Int
  path      String
  element   String
  icon      String?
  preview   String?
  portrait  String?
  updatedAt DateTime @updatedAt
}

model Relic {
  id        String   @id
  name      String
  setId     String?
  setName   String?
  rarity    Int
  icon      String?
  updatedAt DateTime @updatedAt
}

model LightCone {
  id        String   @id
  name      String
  rarity    Int
  path      String
  desc      String?
  icon      String?
  preview   String?
  portrait  String?
  updatedAt DateTime @updatedAt
}

model Item {
  id        String   @id
  name      String
  type      String?
  subType   String?
  rarity    Int
  icon      String?
  updatedAt DateTime @updatedAt
}

model Achievement {
  id        String   @id
  seriesId  String?
  title     String
  desc      String?
  hidden    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Avatar {
  id        String   @id
  name      String
  icon      String?
  updatedAt DateTime @updatedAt
}
